<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OctoShoots.Core</RootNamespace>
    <AssemblyName>OctoShoots.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- The level templates: every level of every build is made by the same ones. -->
    <EmbeddedResource Include="../../data/level_templates.json" LogicalName="OctoShoots.Core.level_templates.json" />
  </ItemGroup>
</Project>
